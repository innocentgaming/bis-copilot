# Database Configuration
POSTGRES_DB=bis_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy URLs
# Async URL for FastAPI application (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bis_copilot

# Sync URL for Alembic migrations and CLI setup scripts (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bis_copilot

# Embedding Model Configuration
# 1536: OpenAI text-embedding-3-small, text-embedding-ada-002
# 768: nomic-embed-text, all-mpnet-base-v2, sentence-transformers
# 1024: bge-large-en, text-embedding-004
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=32

# Ingestion Pipeline Configuration
INGESTION_DATA_DIR=data
RAW_DOCUMENT_DIR=data/raw
PROCESSED_DOCUMENT_DIR=data/processed
FAILED_DOCUMENT_DIR=data/failed

# Chunking Configuration
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# OCR Configuration
OCR_ENABLED=true
OCR_LANGUAGE=eng
MIN_TEXT_DENSITY=0.05

# Environment & Logging
ENVIRONMENT=development
DB_ECHO=false

# Retrieval Configuration
RETRIEVAL_METHOD=hybrid
VECTOR_TOP_K=50
KEYWORD_TOP_K=50
FINAL_TOP_K=10
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
RRF_K=60
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=20
MAX_RETRIEVAL_TOP_K=100
MAX_CANDIDATE_K=500
MAX_CHUNKS_PER_CLAUSE=3
LOW_CONFIDENCE_THRESHOLD=0.25

# Generation & LLM Configuration
LLM_PROVIDER=deterministic
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

GENERATION_ENABLED=true
GENERATION_MAX_CONTEXT_CHUNKS=5
GENERATION_MIN_RELEVANCE_SCORE=0.20
GENERATION_MIN_GROUNDING_SCORE=0.60
GENERATION_CONFIDENCE_THRESHOLD=0.40

ENABLE_CITATION_VALIDATION=true
ENABLE_GROUNDING_VALIDATION=true
ENABLE_HALLUCINATION_GUARD=true
REFUSE_ON_INSUFFICIENT_EVIDENCE=true

ENABLE_STREAMING=true
LOG_LLM_REQUESTS=true
LOG_LLM_RESPONSES=true
STORE_RAW_LLM_RESPONSE=false

# Phase 5 Authentication & Security
JWT_SECRET_KEY=change-this-in-production-super-secret-jwt-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Phase 5 API & CORS
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Phase 5 Rate Limiting & Uploads
RATE_LIMIT_ENABLED=false
RATE_LIMIT_ANONYMOUS_RPM=60
RATE_LIMIT_AUTHENTICATED_RPM=180
RATE_LIMIT_INGESTION_RPM=10
MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=.pdf
CACHE_ENABLED=true
